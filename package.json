{
  "name": "useflow",
  "version": "0.0.7",
  "type": "module",
  "copyright": "金华岩石信息科技有限公司",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron-dev": "electron .",
    "electron-build": "electron-builder",
    "package": "yarn && vite build && electron-builder",
    "releaseit": "release-it",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview"
  },
  "dependencies": {
    "electron-log": "^5.1.7",
    "electron-updater": "^6.3.4"
  },
  "license": "AGPL-3.0-only",
  "devDependencies": {
    "@ant-design/icons": "^5.4.0",
    "@mediapipe/hands": "^0.4.1675469240",
    "@mediapipe/pose": "^0.5.1675469404",
    "@mediapipe/selfie_segmentation": "^0.1.1675465747",
    "@tensorflow-models/body-segmentation": "^1.0.2",
    "@tensorflow-models/hand-pose-detection": "^2.0.1",
    "@tensorflow-models/pose-detection": "^2.1.3",
    "@tensorflow/tfjs-backend-cpu": "^4.20.0",
    "@tensorflow/tfjs-backend-wasm": "^4.20.0",
    "@tensorflow/tfjs-backend-webgl": "^4.20.0",
    "@tensorflow/tfjs-backend-webgpu": "^4.20.0",
    "@tensorflow/tfjs-converter": "^4.20.0",
    "@tensorflow/tfjs-core": "^4.20.0",
    "@types/lodash": "^4.17.7",
    "@types/react": "^18.3.4",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^6.20.0",
    "@typescript-eslint/parser": "^6.20.0",
    "@uidotdev/usehooks": "^2.4.1",
    "@vitejs/plugin-react": "^4.2.1",
    "@xyflow/react": "^12.0.3",
    "ahooks": "^3.8.1",
    "antd": "^5.20.0",
    "crypto-js": "^4.2.0",
    "electron": "^32.0.1",
    "electron-builder": "^24.13.3",
    "eslint": "^8.56.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "fs-imagesize": "^0.1.3",
    "katex": "^0.16.11",
    "lodash": "^4.17.21",
    "lodash.clamp": "^4.0.3",
    "moment": "^2.30.1",
    "nanoid": "^5.0.7",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^9.0.1",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "typescript": "^5.5.4",
    "vite": "^5.0.12",
    "vite-plugin-clean": "^1.0.0",
    "vite-plugin-electron": "^0.28.7",
    "vite-plugin-html": "^3.2.2",
    "vite-plugin-mediapipe": "^0.1.0",
    "vite-plugin-static-copy": "^1.0.6",
    "zustand": "^4.5.5"
  },
  "main": "main.js",
  "build": {
    "publish": [
      {
        "provider": "github",
        "owner": "jianzhichun",
        "repo": "useflow-release",
        "releaseType": "release"
      }
    ],
    "appId": "useflow",
    "productName": "useflow",
    "files": [
      "dist/",
      "main.js",
      "preload.js",
      "package.json",
      {
        "from": "dist/node_modules",
        "to": "dist/node_modules"
      }
    ],
    "directories": {
      "output": "electron-dist"
    },
      "win": {
        "icon": "public/favicon.png",
        "target": [
          {
            "target": "nsis",
            "artifactName": "${productName}.${ext}"
          }
        ]
      },
      "mac": {
        "icon": "public/favicon.icns",
        "target": [
          {
            "target": "default",
            "arch": [
              "universal"
            ],
            "artifactName": "${productName}.${ext}"
          }
        ]
      },
    "dmg": {
      "contents": [
        {
          "x": 110,
          "y": 150
        },
        {
          "x": 240,
          "y": 150,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
